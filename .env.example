# Relative paths are resolved against the repository root.
DATABASE_PATH=data/challenge_hub.sqlite3
# Optional, comma-separated origins for frontends on another local port.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Explicit default: no network or API key needed in local mode.
AI_MODE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
